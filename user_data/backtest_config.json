    "exit_pricing": {
      "price_side": "bid",
      "use_order_book": true,
      "order_book_top": 1
    },
    "order_types": {
      "entry": "limit",
      "exit": "limit",
      "stoploss": "market",
      "stoploss_on_exchange": false
    },
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "exchange": {
